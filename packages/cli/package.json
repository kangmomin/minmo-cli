{
  "name": "@kangmomin/minmo-cli",
  "version": "0.27.0",
  "description": "minmo 원격 CLI — SSH 역터널로 데스크탑의 minmo 서버에 로그인해 메모·설정·보일 저장소를 다루는 명령어",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangmomin/minmo-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kangmomin/minmo-cli#readme",
  "type": "module",
  "bin": {
    "minmo": "dist/minmo.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@minmo/api-client": "*",
    "@minmo/core": "*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
