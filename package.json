{
  "name": "minmo",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "desktop",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspace desktop && npm run build --workspace minmo-cli",
    "e2e": "npm run e2e --workspace desktop",
    "pack:cli": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npm pack --workspace minmo-cli --pack-destination dist"
  }
}
