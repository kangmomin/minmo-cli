{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "minmo 메인 창 권한",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
