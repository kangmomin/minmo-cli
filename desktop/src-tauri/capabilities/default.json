{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "minmo 메인 창 권한",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/login/oauth/*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://github.com/*/*/pull/*" }
      ]
    }
  ]
}
