{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minmo",
  "version": "0.9.0",
  "identifier": "com.minmo.desktop",
  "build": {
    "beforeDevCommand": "npm run build:server && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:server && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "minmo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/minmo-server"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwODU2MzJFREUxREQ2RkIKUldUNzFoM2VMbU9GUUVkTDQ0S09rSjZxMWZobGFaMlBRUFZESkVqZkErUHZoRDliMXM3L3NYV2EK",
      "endpoints": ["https://github.com/kangmomin/minmo-cli/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" },
      "requireSignedVersion": true
    }
  }
}
